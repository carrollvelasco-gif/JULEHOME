# Base de datos (Reseñas de clientes)
# ------------------------------------------------------------
# Crea un proyecto gratuito en https://neon.tech
# Copia la "connection string" (formato postgresql://...) y colócala aquí.
# En Vercel: añade la misma variable en Settings > Environment Variables.
DATABASE_URL=postgresql://usuario:password@ep-xxxx-pooler.us-east-1.aws.neon.tech/julehome?sslmode=require

# Moderación de reseñas (API)
# ------------------------------------------------------------
# Define un token secreto para aprobar/rechazar/eliminar reseñas
# mediante la API. No lo compartas en el cliente.
# En Vercel: añade la misma variable en Settings > Environment Variables.
ADMIN_TOKEN=cambia-este-token-secreto